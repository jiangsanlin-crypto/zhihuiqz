APP_PORT=8080
STATE_DB=/app/data/orchestrator.db

# GitHub write-back token: use a fine-grained token or GitHub App token.
GITHUB_TOKEN=
GITHUB_REPOSITORY=jiangsanlin-crypto/zhihuiqz
GITHUB_WEBHOOK_SECRET=
ORCHESTRATOR_TOKEN=

# WorkBuddy remains an external adapter until its API/CLI is connected.
WORKBUDDY_URL=
WORKBUDDY_TOKEN=

# Self-hosted deterministic sandbox QA runner.
SANDBOX_URL=http://sandbox-runner:8092
SANDBOX_TOKEN=
SANDBOX_RUNNER_TOKEN=
SANDBOX_ALLOWED_REPO=jiangsanlin-crypto/zhihuiqz
SANDBOX_TIMEOUT_SECONDS=300

# Codex is handled by openai/codex-action in GitHub Actions.
CODEX_URL=
CODEX_TOKEN=

MAX_RETRIES=3
