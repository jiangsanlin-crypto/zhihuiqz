APP_PORT=8080
STATE_DB=/app/data/orchestrator.db

# Only the orchestrator gets GitHub write credentials.
GITHUB_TOKEN=
GITHUB_REPOSITORY=jiangsanlin-crypto/zhihuiqz
GITHUB_WEBHOOK_SECRET=
ORCHESTRATOR_TOKEN=

# WorkBuddy reads the public repository directly; no GitHub auth is supplied.
WORKBUDDY_URL=http://workbuddy-runner:8091
WORKBUDDY_TOKEN=
WORKBUDDY_ALLOWED_REPO=jiangsanlin-crypto/zhihuiqz
WORKBUDDY_API_BASE=https://www.workbuddy.cn/openapi/v2
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=
WORKBUDDY_REFRESH_TOKEN=
WORKBUDDY_ACCESS_TOKEN=
WORKBUDDY_TOKEN_FILE=/app/data/workbuddy_oauth.json
WORKBUDDY_TIMEOUT_SECONDS=900
WORKBUDDY_POLL_SECONDS=5

# Sandbox reads the public repository/PR without GitHub credentials.
SANDBOX_URL=http://sandbox-runner:8092
SANDBOX_TOKEN=
SANDBOX_ALLOWED_REPO=jiangsanlin-crypto/zhihuiqz
SANDBOX_TIMEOUT_SECONDS=300

# Codex runs in GitHub Actions.
CODEX_URL=
CODEX_TOKEN=

MAX_RETRIES=3
