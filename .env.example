APP_PORT=8080
STATE_DB=/app/data/orchestrator.db

# Fine-grained GitHub automation token used by the persistent Orchestrator.
# Scope it only to jiangsanlin-crypto/zhihuiqz with Contents/Issues/Pull requests
# read-write. It must not have permission to bypass protected main.
GITHUB_TOKEN=
GITHUB_REPOSITORY=jiangsanlin-crypto/zhihuiqz
GITHUB_WEBHOOK_SECRET=
ORCHESTRATOR_TOKEN=

# WorkBuddy Cloud Task runner. OAuth is optional at bootstrap; without it,
# the stack starts in degraded mode and real cloud dispatch is disabled.
WORKBUDDY_URL=http://workbuddy-runner:8091
# Optional. If omitted, the internal runner reuses ORCHESTRATOR_TOKEN.
WORKBUDDY_TOKEN=
WORKBUDDY_ALLOWED_REPO=jiangsanlin-crypto/zhihuiqz
WORKBUDDY_API_BASE=https://www.workbuddy.cn/openapi/v2
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=
WORKBUDDY_REFRESH_TOKEN=
WORKBUDDY_ACCESS_TOKEN=
WORKBUDDY_TOKEN_FILE=/app/data/workbuddy_oauth.json
WORKBUDDY_TIMEOUT_SECONDS=900
WORKBUDDY_POLL_SECONDS=5

# Strict WorkBuddy model policy.
WORKBUDDY_MODEL=GLM-5.3-Flash
WORKBUDDY_MODEL_LOCK_CONFIRMED=false

# OpenAI workflow pins:
# Codex: gpt-5.6-luna / max
# ChatGPT: gpt-5.6-sol / high

MAX_RETRIES=3
