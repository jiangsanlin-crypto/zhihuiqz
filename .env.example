APP_PORT=8080
STATE_DB=/app/data/orchestrator.db

# GitHub: use a fine-grained token or GitHub App token scoped to this repo.
GITHUB_TOKEN=
GITHUB_REPOSITORY=jiangsanlin-crypto/zhihuiqz
GITHUB_WEBHOOK_SECRET=
ORCHESTRATOR_TOKEN=

# WorkBuddy runner (included).
WORKBUDDY_URL=http://workbuddy-runner:8091
WORKBUDDY_TOKEN=
WORKBUDDY_ALLOWED_REPO=jiangsanlin-crypto/zhihuiqz
WORKBUDDY_API_BASE=https://www.workbuddy.cn/openapi/v2
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=
WORKBUDDY_REFRESH_TOKEN=
WORKBUDDY_ACCESS_TOKEN=
WORKBUDDY_TOKEN_FILE=/app/data/workbuddy_oauth.json
WORKBUDDY_TIMEOUT_SECONDS=900
WORKBUDDY_POLL_SECONDS=5

# Isolated deterministic sandbox QA runner (included).
SANDBOX_URL=http://sandbox-runner:8092
SANDBOX_TOKEN=
SANDBOX_ALLOWED_REPO=jiangsanlin-crypto/zhihuiqz
SANDBOX_TIMEOUT_SECONDS=300

# Codex is handled by openai/codex-action in GitHub Actions.
CODEX_URL=
CODEX_TOKEN=

MAX_RETRIES=3

# KhmerHire application backend
APP_ENV=development
DATABASE_URL=sqlite:///./khmerhire.db
TOKEN_SECRET=change-me-before-production
TOKEN_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
