# Copy to .env.staging on the staging host. Never commit the real file.
POSTGRES_DB=khmerhire
POSTGRES_USER=khmerhire
POSTGRES_PASSWORD=replace-with-long-random-password
TOKEN_SECRET=replace-with-at-least-32-random-bytes
TOKEN_TTL_SECONDS=604800
PUBLIC_ORIGIN=http://localhost:8088
KHMERHIRE_PORT=8088

# Used only by the staging smoke test / admin bootstrap.
SMOKE_ADMIN_PHONE=099999999
SMOKE_ADMIN_PASSWORD=replace-with-a-separate-long-password
